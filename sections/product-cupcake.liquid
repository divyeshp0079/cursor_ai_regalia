{% assign metafield_values = product.metafields.custom.product_handles
  | replace: '[', ''
  | replace: ']', ''
  | replace: '"', ''
  | split: ','
%}
<style>
  .product-container {
    display: flex;
  }
  .product-media {
    flex: 50%;* Adjust width as needed */
  }
  .product-media-header{
    display: flex;
    flex-wrap: wrap;
    max-width: 300px;
    margin: 0 auto;
  }
  .media-item {
    width: calc(33.33% - 10px); /* Three items per row */
    margin: 5px;
    position: relative;
    border: 1px solid #ccc; /* Optional border */
    height: 100px; /* Fixed height for boxes */
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px; /* Adjust font size for numbers */
    color: red; /* Color for numbers */
  }
  .product-list {
    flex: 50%;
  }
  .product-list ul {
    display: flex;
    flex-wrap: wrap;
    list-style-type: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }
  .media-item img, .product-item img {
    width: 100%;
    height: auto; /* Maintain aspect ratio */
  }
  .product-item {
    position: relative;
    margin: 10px;
    width: calc(26% - 20px); /* Adjust width for three columns */
    box-sizing: border-box; /* Include padding and border in width */
    text-align: center;
  }
  .product-item img {
    transition: transform 0.3s;
  }
  .product-item:hover img {
    transform: scale(1.05); /* Zoom effect on hover */
  }
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .product-item:hover .overlay {
    opacity: 1; /* Show overlay on hover */
  }
  .button {
    background: #ff4081; /* Button color */
    color: white;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    margin: 5px;
    border-radius: 5px;
    text-align: center;
  }
  .disabled {
    background: #ccc; /* Disabled button color */
    cursor: not-allowed; /* Change cursor to indicate disabled */
  }
  .product-media-footer{
    text-align: center;
  }
  .close-button {
    position: absolute; /* Position it absolutely within the media-item */
    top: 5px; /* Adjust as needed */
    right: 5px; /* Adjust as needed */
    opacity: 0; /* Hidden by default */
    transition: opacity 0.3s; /* Smooth transition */
  }
  .media-item:hover .close-button {
    opacity: 1; /* Show on hover */
  }
</style>

<div class="product-container container">
  <div class="product-media" id="productMedia">
    <div class="product-media-header">
      <!-- Boxes for selected products -->
      <div class="media-item" id="box1"></div>
      <div class="media-item" id="box2"></div>
      <div class="media-item" id="box3"></div>
      <div class="media-item" id="box4"></div>
      <div class="media-item" id="box5"></div>
      <div class="media-item" id="box6"></div>
      <div class="media-item" id="box7"></div>
      <div class="media-item" id="box8"></div>
      <div class="media-item" id="box9"></div>
      <div class="media-item" id="box10"></div>
      <div class="media-item" id="box11"></div>
      <div class="media-item" id="box12"></div>
    </div>
    <div class="product-media-footer">
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" id="addToCartButton" class="button disabled">Add to Cart</button>
        <div class="product-properties hidden"></div>
      </form>
    </div>
  </div>

  <div class="product-list">
    <ul>
      {% for handle in metafield_values %}
        {% assign matched_product = all_products[handle] %}
        {% if matched_product %}
          <li
            class="product-item"
            data-product-id="{{ matched_product.first_available_variant.id }}"
            data-product-handle="{{ handle }}"
          >
            <img
              src="{{ matched_product.featured_image | img_url: 'medium' }}"
              alt="{{ matched_product.title }}"
              width="200"
              height="200"
            >
            <div class="overlay">
              <div>
                <button
                  class="button"
                  onclick="addToCart('{{ handle }}', '{{ matched_product.featured_image | img_url: 'medium' }}')"
                >
                  Add to Cart
                </button>
                <button class="button" onclick="viewDetails('{{ handle }}')">View Details</button>
              </div>
            </div>
            <h6>{{ matched_product.title }}</h6>
          </li>
        {% else %}
          <li>
            <h6>Product with handle "{{ handle }}" not found.</h6>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

<script>
  const selectedProducts = [];

  function addToCart(handle, imageUrl) {
    if (selectedProducts.length < 12) {
      selectedProducts.push({ handle, imageUrl });
      updateSelectedProducts();
    } else {
      alert('You can only add up to 12 products.');
    }
    updateAddToCartButton();
  }

  function updateSelectedProducts() {
    const boxes = document.querySelectorAll('.media-item');
    const productProperties = document.querySelector('.product-properties');

    // Clear existing boxes
    boxes.forEach((box) => {
      box.innerHTML = ''; // Clear previous images
    });

    // Fill boxes with selected product images
    selectedProducts.forEach((product, index) => {
      if (index < boxes.length) {
        boxes[index].innerHTML = `
          <img src="${product.imageUrl}" alt="${product.handle}" width="100" height="100">
          <button class="close-button" onclick="removeProduct(${index})">X</button>
        `;
      }
    });
    // Add properties for all selected products
    productProperties.innerHTML = ''; // Clear previous properties
    selectedProducts.forEach((product, index) => {
      productProperties.innerHTML += `
        <div data-value="" class="productwrapper${index + 1}">
          <img src="${product.imageUrl}" alt="${product.handle}">
          <input class="addtopro" type="text" name="properties[${index + 1}]" value="${product.handle}">
        </div>
      `;
    });
  }

  document.getElementById('cartForm').addEventListener('submit', function (event) {
    const productProperties = document.querySelector('.product-properties');
    const propertiesInputs = productProperties.querySelectorAll('.addtopro');

    // Loop through each input and add it to the form
    propertiesInputs.forEach((input) => {
      const clonedInput = input.cloneNode(true); // Clone the input
      this.appendChild(clonedInput); // Append it to the form
    });
  });

  function updateAddToCartButton() {
    const button = document.getElementById('addToCartButton');
    if (selectedProducts.length < 12) {
      button.classList.add('disabled');
      button.disabled = true; // Disable the button
    } else {
      button.classList.remove('disabled');
      button.disabled = false; // Enable the button
    }
  }

  function viewDetails(handle) {
    // Redirect to product details page
    window.location.href = '/products/' + handle;
  }

  function removeProduct(index) {
    // Remove the product from the selectedProducts array
    selectedProducts.splice(index, 1);
    updateSelectedProducts(); // Update the display
    updateAddToCartButton(); // Update the button state
  }
</script>
